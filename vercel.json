{
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.6.0"
        }
    },
    "routes": [
        { "src": "/api/(.*)\\.php", "dest": "/api/$1.php" },
        { "src": "/css/(.*)", "dest": "/css/$1" },
        { "src": "/BANNER.png", "dest": "/BANNER.png" },
        { "src": "/Cover.jpg", "dest": "/Cover.jpg" },
        { "src": "/", "dest": "/index.html" }
    ]
}